def wind_direction(deg):
    if 23 <= deg < 68:
        return 'Северо-восток'
    elif 68 <= deg < 113:
        return 'Восток'
    elif 113 <= deg < 158:
        return 'Юго-восток'
    elif 158 <= deg < 203:
        return 'Юг'
    elif 203 <= deg < 248:
        return 'Юго-запад'
    elif 248 <= deg < 293:
        return 'Запад'
    elif 293 <= deg < 338:
        return 'Северо-запад'
    else:
        return 'Северный'


def get_weather(city, api_key):
    global fCounter
    fCounter += 1
    url = f"http://api.openweathermap.org/data/2.5/forecast?q={city}&appid={api_key}"
    response = requests.get(url)
    data = json.loads(response.text)
    return data


